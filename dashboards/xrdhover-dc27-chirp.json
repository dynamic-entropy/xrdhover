            "uid": "${datasource}"
          },
          "expr": "sum by (source, dest, src_dst) (last_over_time(xrdhover_max_inflight{job=~\"$job\", src_dst=~\"$src_dst\", source=~\"$source\", dest=~\"$dest\"}[5m]) and on (job, src_dst, job_id) ((time() - last_over_time(xrdhover_push_time_seconds{job=~\"$job\", src_dst=~\"$src_dst\"}[5m])) < 300))",
          "legendFormat": "max_inflight {{src_dst}}",
          "refId": "B"
        }
      ],
      "title": "In-flight vs max_inflight",
